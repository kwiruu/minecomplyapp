# ==========================================
# MINECOMPLY MOBILE APP - ENVIRONMENT TEMPLATE
# ==========================================
# Copy this file to .env and update the values.
# Never commit .env to version control.

# ==========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ==========================================
# Get these from Supabase Dashboard > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>

# ==========================================
# BACKEND API CONFIGURATION
# ==========================================
# For local development on a physical phone, use your PC LAN IP.
# Android emulator can use http://10.0.2.2:3000/api.
EXPO_PUBLIC_LOCAL_API_BASE_URL=http://<YOUR_PC_LAN_IP>:3000/api

# For APK/EAS production builds.
EXPO_PUBLIC_PRODUCTION_API_BASE_URL=https://minecomplyapi-4a46.onrender.com/api

# ==========================================
# EMAIL CONFIRMATION REDIRECT (OPTIONAL)
# ==========================================
EXPO_PUBLIC_CONFIRMATION_REDIRECT_URL=https://kwiruu.github.io/minecomplyconfirmpage/

# Backend-only secrets such as DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_JWT_SECRET, and SUPABASE_JWKS_URL do not belong in this file.
